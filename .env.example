EDGAR_CONTACT_EMAIL=you@example.com
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/edgar_radar
JWT_SECRET=replace_with_a_long_random_string
ALERT_SLACK_WEBHOOK_URL=
ALERT_HEARTBEAT_THRESHOLD_MINUTES=60
REDIS_URL=redis://localhost:6379
# Optional (Phase 6) - pino's minimum log level: trace/debug/info/warn/error/fatal.
# Defaults to 'info' if unset - see src/logger.ts.
LOG_LEVEL=

# Optional (Phase 6 step 9) - set to exactly `true` to mount the Bull Board
# queue dashboard at /admin/queues. Left empty (off) by default ON PURPOSE:
# Bull Board has no authentication and can retry, promote and delete jobs, so
# serving it from a public host exposes a write-capable admin surface to
# anyone. Turn it on for local development; on a deployed host, reach it with
# an SSH tunnel (`ssh -L 3000:localhost:3000 user@host`) rather than by
# enabling this. See the mount site in src/app.ts.
ENABLE_BULL_BOARD=

# Optional (Phase 7 step 2) - a read replica for the API's read-heavy
# endpoints (GET /companies/...). Left empty, every read goes to DATABASE_URL,
# which is right for `npm run dev` on the host. Under docker compose you do not
# set this here: docker-compose.yml points the API at its own
# `postgres-replica` service. If set, it must be a postgres:// URL - the API
# refuses to start otherwise (see src/config.ts). A replica that is down is
# not fatal: reads fall back to DATABASE_URL (see src/db.ts).
READ_DATABASE_URL=

# Optional (Phase 7 step 3) - a Redis used as a response cache for the API's
# GET /companies/... endpoints. Must NOT be the queue Redis in REDIS_URL: the
# cache needs an eviction policy and the queue must never evict (see
# docker-compose.yml's `redis-cache`). Left empty, nothing is cached, which is
# right for `npm run dev` on the host. Under docker compose you do not set
# this here: docker-compose.yml points the API and parser worker at
# `redis-cache`. If set, it must be a redis:// URL. An unreachable cache is
# not fatal: requests are served from Postgres (see src/cache.ts).
CACHE_REDIS_URL=

# Optional (post-Phase 7) - this process's share of SEC's 10 requests/second.
# Several services call SEC, and each limits only itself, so
# docker-compose.yml gives each one a share (see its header comment). Left
# empty, a process run on its own - e.g. `npm run backfill` here - uses 7.
# If set, it must be a number greater than 0 and at most 8.
SEC_REQUESTS_PER_SECOND=

# The vars below configure docker-compose's own `postgres` container (Phase
# 6) and are used to build that stack's internal DATABASE_URL. They are
# independent of DATABASE_URL above, which is for running the app directly
# on the host (`npm run dev`) against a `localhost` Postgres - inside
# Compose's network, "localhost" would refer to each container itself, not
# the postgres service, so Compose constructs its own connection string from
# these instead of reusing DATABASE_URL. Defaults (used if these are left
# unset) already match the values below, so `docker-compose up` works with
# this file copied to `.env` completely unmodified.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edgar_radar
