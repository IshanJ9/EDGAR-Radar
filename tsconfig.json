{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node", "jest"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node", "jest"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    /* Emit compiled JS to dist/ for the Docker runtime image (Phase 6).
       Everything still runs from TypeScript via ts-node in local dev; this
       only defines where `npm run build` puts its output. Note the emitted
       layout mirrors the repo (dist/src/..., dist/scripts/...), since tsc
       infers the common root from the included files. */
    "outDir": "dist",
  },
  "ts-node": {
    "files": true
  },
  // Test files are compiled independently by ts-jest (jest.config.js), which
  // reads this file's compilerOptions directly - they do not need to go
  // through `tsc`/`npm run build`. Excluded here so they never end up
  // compiled into dist/ and shipped inside the production Docker image.
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
